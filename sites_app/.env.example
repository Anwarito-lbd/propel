# Required for AI PDF resume extraction, tailored CV/cover-letter/outreach generation, and Interview Coach
GEMINI_API_KEY=
# Optional Gemini model override (defaults to gemini-3-flash-preview, falling back to gemini-2.5-flash)
GEMINI_MODEL=

# Optional ElevenLabs server-side voice narration in Interview Coach
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional Apify LinkedIn public jobs actor (up to 10 results/search)
APIFY_API_TOKEN=

# Optional Crawl4AI Python sidecar (see services/crawl4ai/)
CRAWL4AI_API_URL=
CRAWL4AI_API_KEY=

# Optional external JobSpy service
JOBSPY_API_URL=
JOBSPY_API_KEY=
